# Razorpay TEST MODE keys only. Never commit a live key.
# Dashboard -> Settings -> API Keys (with the Test/Live toggle on Test).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Verifies the raw webhook body via HMAC-SHA256 (PRD 9.3).
RAZORPAY_WEBHOOK_SECRET=

# Optional. Enables the LLM arm (python -m evaluation.run_llm).
# https://openrouter.ai/keys — one model string swaps providers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
